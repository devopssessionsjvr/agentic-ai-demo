# AI-Showcase Application Environment Variables
# Copy this file to .env and update with your values

# Application Environment
NODE_ENV=development
PORT=3000

# Kubernetes Environment Variables (set by downward API)
POD_NAME=ai-showcase-pod
NAMESPACE=ai-showcase
POD_IP=
NODE_NAME=

# Application Configuration
LOG_LEVEL=info
DEBUG=false

# API Configuration
API_TIMEOUT=30000
MAX_REQUEST_SIZE=10mb
